{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/propuesta/(.*)", "dest": "/propuesta.html?id=$1" },
    { "src": "/contrato/(.*)", "dest": "/contrato.html?id=$1" },
    { "src": "/formulario/(.*)", "dest": "/formulario.html?id=$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
